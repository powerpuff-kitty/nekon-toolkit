{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "noEmitOnError": true,
    "skipLibCheck": false,
    "rootDir": "src",
    "outDir": "dist",
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/application-event-payload.ts",
    "src/client-transport.ts",
    "src/client-request-transport.ts",
    "src/bounded-response.ts",
    "src/application-device-authorization-api-resource.ts",
    "src/application-enrollment.ts",
    "src/application-enrollment-storage.ts",
    "src/application-enrollment-proof.ts",
    "src/local-vault.ts"
  ]
}
