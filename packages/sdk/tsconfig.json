{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "noEmitOnError": true,
    "skipLibCheck": false,
    "rootDir": "src",
    "outDir": "dist",
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@nekon/client-runtime/application-event": [
        "../client-runtime/dist/application-event-payload.d.ts"
      ],
      "@nekon/client-runtime/application-authorization": [
        "../client-runtime/dist/application-device-authorization-api-resource.d.ts"
      ],
      "@nekon/client-runtime/application-enrollment": [
        "../client-runtime/dist/application-enrollment.d.ts"
      ],
      "@nekon/client-runtime/application-enrollment-storage": [
        "../client-runtime/dist/application-enrollment-storage.d.ts"
      ],
      "@nekon/client-runtime/application-enrollment-proof": [
        "../client-runtime/dist/application-enrollment-proof.d.ts"
      ],
      "@nekon/client-runtime/local-vault": [
        "../client-runtime/dist/local-vault.d.ts"
      ]
    }
  },
  "include": [
    "src/application-event.ts",
    "src/application-authorization.ts",
    "src/application-enrollment.ts",
    "src/application-enrollment-storage.ts",
    "src/application-enrollment-proof.ts",
    "src/local-vault.ts"
  ]
}
